<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoJing" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.MoJing.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.MoJing</item>
    </style>
</resources>