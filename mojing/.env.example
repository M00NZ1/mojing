# 墨境 — 环境变量示例
# 与 backend/app/config.py 中 Settings 对应，变量名须带前缀 MOJING_
# 复制本文件为项目根目录 .env 后按需修改

# 数据库（默认 SQLite，路径相对 backend 工作目录）
# MOJING_DATABASE_URL=sqlite:///./storage/app.db

# API Key 等字段加密（留空则运行时生成；需要长期固定密钥时再填写）
# MOJING_ENCRYPTION_KEY=

# CORS 来源 JSON 数组，默认允许全部
# MOJING_CORS_ORIGINS=["http://127.0.0.1:5175"]
